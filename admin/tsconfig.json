// Specialized tsconfig for the admin directory,
// includes DOM typings and configures the admin build
{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./build",
        "sourceMap": true,
        "sourceRoot": "./src",
        "allowJs": false,
        "checkJs": false,
        "lib": ["es2023", "DOM", "DOM.Iterable"],
        // only load the ioBroker and Node.js globals, so ioBroker.State etc. resolve correctly
        "types": ["iobroker", "node"],
        "jsx": "react"
    },
    "include": ["./src/**/*.ts", "./src/**/*.tsx", "../src/lib/adapter-config.d.ts"],
    "exclude": ["./**/*.test.ts", "./**/*.test.tsx"]
}
