// Specialized tsconfig for the admin directory,
// includes DOM typings and configures the admin build
{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./build",
        "sourceMap": true,
        "sourceRoot": "./src",
        "noImplicitAny": false,
        "lib": ["es2018", "DOM"],
        // only load the ioBroker and Node.js globals, so ioBroker.State etc. resolve correctly
        "types": ["iobroker", "node"],
        "jsx": "react"
    },
    "include": ["./**/*.d.ts", "./**/*.jsx", "../lib/adapter-config.d.ts"],
    "exclude": ["./**/*.test.jsx"]
}
