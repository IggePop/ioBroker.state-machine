# Line endings: always LF, also in the working copy on Windows, like Prettier expects it
* text=auto eol=lf

# The built adapter (build/) and admin tab (admin/build/) are generated by "npm run build". Git must store
# them unchanged (no line ending conversion), so the check in the workflow compares exactly what esbuild produces.
build/** -text -diff linguist-generated=true
admin/build/** -text -diff linguist-generated=true
