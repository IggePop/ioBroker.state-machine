// Root tsconfig to set the settings and power editor support for all TS files
{
    // To update the compilation target, install a different version of @tsconfig/node... and reference it here
    // https://github.com/tsconfig/bases#node-22-tsconfigjson
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        // do not compile anything, this file is just to configure type checking
        // the compilation is configured in tsconfig.build.json
        "noEmit": true,

        // check the remaining JS files (tests and tools) as well
        "allowJs": true,
        "checkJs": true,

        // This is necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,

        // the mocha globals (describe, it, ...) are needed for the *.test.ts files
        "types": ["node", "mocha"],

        "noImplicitOverride": true,
        "useUnknownInCatchVariables": false
    },
    "include": ["src/**/*.ts", "test/**/*.js", "tools/**/*.js"],
    "exclude": ["build/**", "node_modules/**", "admin/**"]
}
